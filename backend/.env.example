MUVPACK_SECRET_KEY=change-me
MUVPACK_DATABASE_URL=sqlite:///./muvpack.db
MUVPACK_COOKIE_SECURE=0
MUVPACK_SESSION_SAMESITE=lax

# In produzione (frontend e API su domini diversi): SameSite=None + Secure, e CORS esplicito
# CORS_ORIGINS=https://muvpack-web.onrender.com
# CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*onrender\.com

# Stripe: se assente, il checkout funziona in modalita demo (accredito immediato)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP: se assente, le email di tracking risultano "sent" senza invio reale
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@muvpack.it
