MUVPACK_SECRET_KEY=change-me
MUVPACK_DATABASE_URL=sqlite:///./muvpack.db
MUVPACK_COOKIE_SECURE=0
MUVPACK_SESSION_SAMESITE=lax

# In produzione (frontend e API su domini diversi): SameSite=None + Secure, e CORS esplicito
# CORS_ORIGINS=https://muvpack-web.onrender.com
# CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*onrender\.com

# Stripe: se assente, il checkout funziona in modalita demo (accredito immediato)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP: se assente, le email di tracking risultano "sent" senza invio reale
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@muvpack.it

# TravelBox Connector (portale TravelBox Contorno)
TRAVELBOX_BASE_URL=https://www.travelboxcontorno.it
TRAVELBOX_USERID=
TRAVELBOX_PASSWORD=
TRAVELBOX_MIN_INTERVAL=0.8
TRAVELBOX_CACHE_TTL=300
# Preventivi reali nel flusso /api/quote (utenti autenticati; 1 = anche anonimi)
TRAVELBOX_QUOTES_ENABLED=1
TRAVELBOX_QUOTES_PUBLIC=0
TRAVELBOX_QUOTE_CACHE_TTL=300
# Mittente TravelBox: se vuoto viene preso il primo "Mittente" dalla rubrica del portale
TRAVELBOX_SENDER_ID=
TRAVELBOX_SENDER_CITY=
TRAVELBOX_SENDER_CAP=
TRAVELBOX_SENDER_PROVINCE=
# Chiave opzionale per uso server-to-server (header X-TravelBox-Key)
TRAVELBOX_API_KEY=
